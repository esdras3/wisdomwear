# WISDOM WEAR — ambiente de exemplo (sem segredos)
# Prefira editar env/local/20-tenants/wisdomwear/*.env e rodar: npm run env:build

NEXT_PUBLIC_APP_URL=https://wisdomwear.com.br
NEXT_PUBLIC_TENANT_ID=wisdomwear
NEXT_PUBLIC_TENANT_NAME=Wisdom Wear
WISDOMWEAR_APP_URL=https://wisdomwear.com.br
WISDOMWEAR_TENANT_ID=wisdomwear

# Admin
WISDOMWEAR_ADMIN_EMAIL=admin@wisdomwear.com.br
WISDOMWEAR_ADMIN_PASSWORD=
ADMIN_EMAIL=admin@wisdomwear.com.br
ADMIN_PASSWORD=

# Asaas (sem split)
WISDOMWEAR_ASAAS_API_URL=https://sandbox.asaas.com/api/v3
WISDOMWEAR_ASAAS_SUBACCOUNT_API_KEY=
WISDOMWEAR_ASAAS_WEBHOOK_SECRET=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_SUBACCOUNT_API_KEY=
ASAAS_WEBHOOK_SECRET=

# Melhor Envio
WISDOMWEAR_MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br/api/v2
WISDOMWEAR_MELHOR_ENVIO_TOKEN=
WISDOMWEAR_MELHOR_ENVIO_POSTAL_CODE_ORIGIN=01001000
MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br/api/v2
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_POSTAL_CODE_ORIGIN=01001000

# Database (VPS hub-postgres)
WISDOMWEAR_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5433/wisdomwear
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5433/wisdomwear
